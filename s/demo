#!/usr/bin/env bash
# Serve the web demo locally and open it in a browser.
#
# The demo embeds its data (no fetch) so it also works straight from file://,
# but serving it matches how it is published (GitHub Pages).
#
# Usage:
#   s/demo            # serve on port 8002 and open the dashboard
#   PORT=9000 s/demo  # use a different port
#
# Ctrl+C stops the server.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIR="$ROOT/docs/demo"
PORT="${PORT:-8002}"
URL="http://localhost:$PORT/"

echo "Serving demo at $URL"
echo "Press Ctrl+C to stop."

# Open the browser shortly after the server starts. Tolerant of missing openers.
( sleep 1; (xdg-open "$URL" || open "$URL" || sensible-browser "$URL") >/dev/null 2>&1 || true ) &

exec python3 -m http.server "$PORT" --directory "$DIR"
