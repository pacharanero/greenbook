#!/usr/bin/env bash
# Build the documentation site and serve it locally with Docker.
#
# Builds the Zensical site (which includes the demo and presentation) into
# ./site, then spins up one small nginx container (see docker-compose.yml) to
# serve it. Once it is up, open http://localhost:8080/ - the demo is at /demo/
# and the presentation at /presentation/.
#
# For live-reload editing of the docs, use `s/docs` instead (no Docker).
#
# Usage:
#   s/up        # build + start; press Ctrl+C to stop
#
# Requires the docs deps (pip install -r requirements.txt) and Docker.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

URL="http://localhost:8080/"

if ! command -v zensical >/dev/null 2>&1; then
  echo "zensical is not installed. Run: pip install -r requirements.txt" >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is not installed. Install it from https://www.docker.com/ and try again." >&2
  exit 1
fi

echo "Building the documentation site into ./site ..."
zensical build --clean

# Prefer the modern `docker compose`; fall back to the older `docker-compose`.
if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "Docker Compose is not available. Update Docker (Desktop) and try again." >&2
  exit 1
fi

echo "Serving the greenbook docs site at $URL"
echo "Press Ctrl+C to stop."

# Open the browser once nginx has had a moment to start. Tolerant of no opener.
( sleep 2; (xdg-open "$URL" || open "$URL" || sensible-browser "$URL") >/dev/null 2>&1 || true ) &

exec "${COMPOSE[@]}" up
