{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMR catch-up — test scenarios",
  "description": "Six patient cases used to test schedule-aware classification of MMR vaccination records. Each case lists the inputs (DOB and full vaccination history) and the expected classifier output.",
  "scheduleRules": {
    "programme": "MMR",
    "minAgeMonths": {
      "dose1": 12,
      "dose2": 15
    },
    "minIntervalDaysBetweenValidDoses": 28,
    "maxSequence": 2,
    "outOfScheduleReasons": [
      {
        "key": "BeforeAge12Months",
        "label": "Given before age 12 months",
        "trigger": "Given dose with createdAt < dob + 12 months and Dose 1 slot still open"
      },
      {
        "key": "BeforeAge15Months",
        "label": "Given before age 15 months",
        "trigger": "Given dose with createdAt < dob + 15 months and Dose 2 slot still open"
      },
      {
        "key": "LessThan28DaysAfterPrevious",
        "label": "Given less than 28 days after previous dose",
        "trigger": "Given dose with createdAt - lastValidGiven.createdAt < 28 days"
      },
      {
        "key": "ExtraDose",
        "label": "Additional dose",
        "trigger": "Given dose arriving when both schedule slots are already filled"
      }
    ],
    "classificationOrder": "chronological by createdAt ascending",
    "nonGivenOutcomesIgnored": ["Absent", "Refused", "Unwell", "Contraindicated", "Partially vaccinated"],
    "eligibleFromLogic": "nextSlot = validDoses.length + 1; if nextSlot > 2 then null; else max(dob + minAgeMonths[nextSlot], lastValidGiven.createdAt + 28 days) — second term only applied when a previous valid dose exists"
  },
  "vaccines": {
    "13968211000001108": { "brand": "M-M-RvaxPro", "type": "MMR", "manufacturer": "Merck Sharp & Dohme (UK) Ltd" },
    "34925111000001104": { "brand": "Priorix", "type": "MMR", "manufacturer": "GlaxoSmithKline UK Ltd" },
    "99926011000001103": { "brand": "ProQuad", "type": "MMRV", "manufacturer": "Merck Sharp & Dohme (UK) Ltd", "note": "Off-schedule UK; included to model miscoded records" },
    "39779611000001104": { "brand": "MenQuadfi", "type": "MenACWY", "manufacturer": "Sanofi" },
    "7374311000001101": { "brand": "Revaxis", "type": "Td/IPV", "manufacturer": "Sanofi" }
  },
